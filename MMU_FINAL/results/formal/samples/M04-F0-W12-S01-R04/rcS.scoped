MMU_W12_B64
if ! gzip -dc /tmp/mmu-w12.gz > /tmp/mmu-w12; then
  echo "[mmu-w12] FATAL payload decode failed"
  m5 exit
fi
chmod +x /tmp/mmu-w12
# Optional: pin the decoy PFN observed in the no-fault control run:
#   /tmp/mmu-w12 --ctx R04 --decoy-pfn 0x<hex>
# This script uses auto mode (--decoy-pfn 0).
echo "[mmu-w12] start"
/tmp/mmu-w12 --ctx R04
rc=$?
echo "[mmu-w12] rc=$rc"
m5 exit
