#!/bin/sh
# WHEN-5X3 bootstrap: single-line payload (no per-line shell overhead).
echo "W5X3-BOOTSTRAP start"
if [ ! -x /root/w5x3_w10 ]; then
  echo "W5X3-BOOTSTRAP installing"
  base64 -d > /tmp/w5x3_all.tar.xz <<'W5X3_BOOT_B64'

W5X3_BOOT_B64
  echo "W5X3-BOOTSTRAP decoded"
  if ! xz -dc /tmp/w5x3_all.tar.xz > /tmp/w5x3_all.tar; then echo "W5X3-BOOTSTRAP FATAL xz"; m5 exit; fi
  echo "W5X3-BOOTSTRAP decompressed"
  mkdir -p /tmp/w5x3_inst
  if ! tar -xf /tmp/w5x3_all.tar -C /tmp/w5x3_inst; then echo "W5X3-BOOTSTRAP FATAL tar"; m5 exit; fi
  for n in 9 10 11 12 13 14; do cp /tmp/w5x3_inst/mmu_w$n /root/w5x3_w$n; chmod 755 /root/w5x3_w$n; done
  cp /tmp/w5x3_inst/mmu_w10s /root/w5x3_w10s; chmod 755 /root/w5x3_w10s
  ls -l /root/w5x3_*
  echo "W5X3-BOOTSTRAP checkpointing"
  m5 checkpoint
  echo "W5X3-BOOTSTRAP checkpoint rc=$?"
fi
m5 readfile > /tmp/w5x3_run.sh
SZ=$(wc -c < /tmp/w5x3_run.sh)
echo "W5X3-BOOTSTRAP runfile size=$SZ"
if [ "$SZ" -gt 0 ] && [ "$SZ" -lt 5000 ]; then
  echo "W5X3-BOOTSTRAP exec runfile"
  sh /tmp/w5x3_run.sh
fi
echo "W5X3-BOOTSTRAP done"
m5 exit
