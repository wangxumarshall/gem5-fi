+#ifndef __CPU_O3_RFWB_HH__
+#define __CPU_O3_RFWB_HH__
+
+#include <cstdint>
+#include <fstream>
+#include <string>
+#include <unordered_set>
+#include <unordered_map>
+#include <vector>
+
+#include "base/types.hh"
