{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gem5-fi.local/schemas/fsu_suite.schema.json",
  "title": "FSU W5 fixed suite manifest (PolyBench-FP v1)",
  "description": "W5 suite identity. program_order is fixed: gemm, 2mm, lu, cholesky, jacobi-2d. suite_hash is SHA-256 over canonical JSON of identity fields only (never run results).",
  "type": "object",
  "required": [
    "suite_id",
    "suite_version",
    "program_order",
    "program_count",
    "programs",
    "compiler",
    "oracle",
    "suite_hash"
  ],
  "properties": {
    "suite_id": {"type": "string", "minLength": 1},
    "suite_version": {"type": "string", "minLength": 1},
    "program_order": {
      "type": "array",
      "const": ["gemm", "2mm", "lu", "cholesky", "jacobi-2d"],
      "items": {"enum": ["gemm", "2mm", "lu", "cholesky", "jacobi-2d"]},
      "minItems": 5,
      "maxItems": 5
    },
    "program_count": {"const": 5},
    "programs": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "program_id",
          "program_index",
          "source_sha256",
          "binary_sha256",
          "scale"
        ],
        "properties": {
          "program_id": {"enum": ["gemm", "2mm", "lu", "cholesky", "jacobi-2d"]},
          "program_index": {"type": "integer", "minimum": 0, "maximum": 4},
          "source_sha256": {
            "type": "string",
            "pattern": "^(pending|[0-9a-f]{64})$"
          },
          "binary_sha256": {
            "type": "string",
            "pattern": "^(pending|[0-9a-f]{64})$"
          },
          "golden": {"type": "string", "minLength": 1},
          "scale": {"type": "object", "minProperties": 1},
          "element_oracle": {
            "type": "object",
            "required": ["golden_array", "meta", "oracle_version"],
            "properties": {
              "golden_array": {"type": "string", "minLength": 1},
              "oracle_version": {"type": "string", "minLength": 1},
              "meta": {
                "type": "object",
                "required": [
                  "program_id", "golden_id", "dtype", "layout",
                  "endianness", "count", "shape", "abs_tol", "rel_tol",
                  "ulp_tol", "oracle_version"
                ]
              }
            }
          }
        }
      }
    },
    "seed_plan": {
      "type": "array",
      "description": "F5 pre-registration: exactly three formal suite seeds, each freezing submodel/precision/mask/polarity/warm-up/bounded sampling. Geometry fields are optional and inherit program_overrides when omitted. Covered by suite_hash.",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "suite_seed", "submodel", "mask", "polarity",
          "warmup", "sample"
        ],
        "properties": {
          "suite_seed": {"type": "integer", "enum": [1, 2, 3]},
          "submodel": {"type": "string", "minLength": 1},
          "bitseg": {
            "type": "string",
            "enum": ["sign", "exp_hi", "exp_lo", "mant_hi", "mant_mid", "mant_lo"]
          },
          "precision": {"type": "string", "enum": ["fp32", "fp64"]},
          "lane_width": {"type": "integer", "enum": [8, 16, 32, 64]},
          "lane_offset": {"type": "integer", "minimum": 0},
          "mask": {"type": "string", "pattern": "^0x[0-9a-fA-F]{1,16}$"},
          "polarity": {"type": "integer", "enum": [0, 1]},
          "warmup": {"type": "integer", "minimum": 0},
          "sample": {
            "type": "object",
            "required": ["limit", "keep_first_last_n"],
            "properties": {
              "limit": {"type": "integer", "minimum": 0},
              "keep_first_last_n": {"type": "integer", "minimum": 0}
            }
          },
          "op_classes": {"type": "array", "items": {"type": "string"}},
          "reg_class": {"type": "string", "enum": ["any", "vec", "float", "vec_elem"]},
          "decode_guard": {"type": "boolean"},
          "permanent_stuck": {"type": "boolean"},
          "program_mask": {
            "type": "object",
            "description": "Per-program mask override for this suite seed (program_id -> 0x... hex). Highest-precedence mask.",
            "minProperties": 1,
            "additionalProperties": {"type": "string", "pattern": "^0x[0-9a-fA-F]{1,16}$"}
          }
        }
      }
    },
    "program_overrides": {
      "type": "object",
      "description": "Per-program injector overrides (SVD fp64 vs FFT/sparse fp32). Applied after suite.injector and before seed_plan; a fault_mask here is a per-program final mask. Covered by suite_hash.",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["fpu_mode"],
        "properties": {
          "fpu_mode": {
            "type": "object",
            "minProperties": 1,
            "properties": {
              "bitseg": {
                "type": "string",
                "enum": ["sign", "exp_hi", "exp_lo", "mant_hi", "mant_mid", "mant_lo"]
              },
              "precision": {"type": "string", "enum": ["fp32", "fp64"]},
              "lane_width": {"type": "integer", "enum": [8, 16, 32, 64]},
              "lane_offset": {"type": "integer", "minimum": 0},
              "decode_guard": {"type": "boolean"},
              "permanent_stuck": {"type": "boolean"},
              "stuck_polarity": {"type": "integer", "enum": [0, 1]},
              "f5_warmup": {"type": "integer", "minimum": 0},
              "f5_sample_limit": {"type": "integer", "minimum": 0},
              "f5_keep_first_last_n": {"type": "integer", "minimum": 0},
              "op_classes": {"type": "array", "items": {"type": "string"}},
              "reg_class": {"type": "string", "enum": ["any", "vec", "float", "vec_elem"]}
            }
          },
          "fault_mask": {"type": "string", "pattern": "^0x[0-9a-fA-F]{1,16}$"},
          "max_faults": {"const": 1},
          "first_clock": {"type": "integer", "minimum": 0}
        }
      }
    },
    "scale": {"type": "object"},
    "compiler": {
      "type": "object",
      "required": ["version", "cflags"],
      "properties": {
        "cc": {"type": "string"},
        "version": {"type": "string", "minLength": 1},
        "cflags": {
          "oneOf": [
            {"type": "string", "minLength": 1},
            {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string"}
            }
          ]
        }
      }
    },
    "oracle": {
      "type": "object",
      "required": ["version"],
      "properties": {
        "id": {"type": "string"},
        "version": {"type": "string", "minLength": 1},
        "kind": {"type": "string"}
      }
    },
    "suite_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
