#!/bin/sh
# v1.3 Phase 20 §21: sysreg_churn — MRS-read the §2.10 whitelist in a dense
# loop so CHAOSArmSysReg's MRS-read-path hook has eligible events AND the
# corrupted value is immediately consumed (folded into FINAL= checksum).
# The churn binary is embedded base64 (nostdlib, 1648 bytes) — the readfile
# mechanism only serves text scripts.
echo '[sysreg_churn.rcS] decoding workload'
echo '' | base64 -d > /tmp/sysreg_churn
chmod +x /tmp/sysreg_churn
echo '[sysreg_churn.rcS] running churn'
/tmp/sysreg_churn
echo "[sysreg_churn.rcS] churn done rc=$?"
m5 exit
