H9xf/v8AoGlf/ejECQA=
MMU_W10S_B64
if ! gzip -dc /tmp/mmu-w10s.gz > /tmp/mmu-w10s; then
  echo "[mmu-w10s] FATAL payload decode failed"
  m5 exit
fi
chmod +x /tmp/mmu-w10s
BUF_DIR=/var/tmp/w10s
mkdir -p "$BUF_DIR" 2>/dev/null || BUF_DIR=/tmp
[ -w "$BUF_DIR" ] || BUF_DIR=/tmp
echo "[mmu-w10s] buffer_dir=$BUF_DIR"
# ---- run-time variant parameters ----
W10S_VARIANT=W10S-WARM-STORE
W10S_MODE=warm
W10S_TARGET_VA=0x4001400000
W10S_BUFFER_VA=0x4002000000
W10S_PAGES=4096
W10S_MAX_PAGES=65536
echo "[mmu-w10s] variant=$W10S_VARIANT mode=$W10S_MODE target_va=$W10S_TARGET_VA"
if command -v timeout >/dev/null 2>&1; then
  timeout -s KILL 60 /tmp/mmu-w10s --"$W10S_MODE" \
    --target-va "$W10S_TARGET_VA" --buffer-va "$W10S_BUFFER_VA" \
    --pages "$W10S_PAGES" --max-pages "$W10S_MAX_PAGES" \
    --file-dir "$BUF_DIR"
else
  /tmp/mmu-w10s --"$W10S_MODE" \
    --target-va "$W10S_TARGET_VA" --buffer-va "$W10S_BUFFER_VA" \
    --pages "$W10S_PAGES" --max-pages "$W10S_MAX_PAGES" \
    --file-dir "$BUF_DIR"
fi
echo "[mmu-w10s] variant=$W10S_VARIANT rc=$?"
m5 exit
