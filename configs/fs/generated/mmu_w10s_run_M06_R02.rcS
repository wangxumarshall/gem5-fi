MMU_W10S_B64
if ! gzip -dc /tmp/mmu-w10s.gz > /tmp/mmu-w10s; then
  echo "[mmu-w10s] FATAL payload decode failed"
  m5 exit
fi
chmod +x /tmp/mmu-w10s
BUF_DIR=/var/tmp/w10s
mkdir -p "$BUF_DIR" 2>/dev/null || BUF_DIR=/tmp
[ -w "$BUF_DIR" ] || BUF_DIR=/tmp
echo "[mmu-w10s] buffer_dir=$BUF_DIR"
echo "[mmu-w10s] scoped template: M06_R02 only"
# ---- W10S_VARIANT M06_R02 BEGIN ----
echo "[mmu-w10s] variant=M06_R02 mode=cold target_va=0x4001100000"
if command -v timeout >/dev/null 2>&1; then
  timeout -s KILL 60 /tmp/mmu-w10s --cold --target-va 0x4001100000 --file-dir "$BUF_DIR"
else
  /tmp/mmu-w10s --cold --target-va 0x4001100000 --file-dir "$BUF_DIR"
fi
echo "[mmu-w10s] variant=M06_R02 rc=$?"
# ---- W10S_VARIANT M06_R02 END ----
m5 exit
