#!/bin/sh
ulimit -l unlimited 2>/dev/null || true
mkdir -p /mnt/shm
if mount -t tmpfs -o size=64M tmpfs /mnt/shm 2>/tmp/mount.err; then
  BUF=/mnt/shm/mmu_w10_pages
else
  echo "[mmu-w10] tmpfs mount failed: $(cat /tmp/mount.err 2>/dev/null)"
  BUF=/tmp/mmu_w10_pages
fi
ln -sf "$BUF" /tmp/mmu_w10_pages.bin
