AAAAAAAAAAAAAAA=
B64_litmus_mp
chmod +x /tmp/litmus_mp
echo "[litmus.rcS] /tmp/litmus_mp sha256=$(sha256sum /tmp/litmus_mp | cut -d' ' -f1) size=642344"


# 运行顺序：atomic 最先（最可能给出可读 oracle），然后 sb，最后 mp
#（mp 在无一致性的 classic 多核上必然挂死 —— 那本身就是证据，见 R4-8-FSMC 报告）。
rc=0
for t in litmus_atomic litmus_sb litmus_mp; do
    echo "[litmus.rcS] ===== running /tmp/$t ====="
    /tmp/$t
    echo "[litmus.rcS] /tmp/$t exit=$?"
done
echo "[litmus.rcS] payload finished"
m5 exit
