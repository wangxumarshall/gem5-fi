B64_litmus_free
chmod +x /tmp/litmus_free
echo "[litmus_free.rcS] sha256=$(sha256sum /tmp/litmus_free | cut -d' ' -f1) size=9392 emb=12524"
echo "[litmus_free.rcS] ===== running /tmp/litmus_free ====="
/tmp/litmus_free
echo "[litmus_free.rcS] exit=$?"

# ---- heredoc 阶梯（诊断臂）---------------------------------------------
# 与上面解码 litmus_free 用的是**同一套机制**，只改字节数，用来把"卡点"
# 从"猜"变成"量"：每一级打 start/done 两个标记，宿主侧对 board.terminal
# 带时间戳轮询即得"每级墙钟耗时"。null 级写 /dev/null（隔离解码成本），
# file 级写 /tmp（叠加 guest 磁盘写成本）。纯 shell：echo 是 dash 内建，
# 每级只 fork/exec 一次 base64。
echo "[ladder] BEGIN"
echo "[ladder] L64K start b64=87384"
