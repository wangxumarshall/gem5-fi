# -*- mode:python -*-
# CHAOSArmTLB — ARM-only fault injector (Phase 3 §六.4 item 3).
# ARM-only: hooks arch/arm/{isa.cc,tlb.cc} — must NOT compile under X86/etc
# (it includes arch/arm/isa.hh). Discovered by src/SConscript's os.walk; the
# USE_ARM_ISA guard below skips it for non-ARM builds (X86 build would otherwise
# fail on the arm-ISA include + System.hh dependency ordering).

Import('*')

if not env["CONF"]["USE_ARM_ISA"]:
    Return()

SimObject('CHAOSArmTLB.py', sim_objects=['CHAOSArmTLB'], enums=[])
Source('CHAOSArmTLB.cc')
