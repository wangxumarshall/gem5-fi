+    uint64_t
+    CHAOSPropagation::mmuBeginConsumerTranslation(uint64_t seq, Addr va,
+                                                  const char *mode,
+                                                  bool stage2, uint16_t asid,
+                                                  uint16_t vmid,
+                                                  unsigned regime,
