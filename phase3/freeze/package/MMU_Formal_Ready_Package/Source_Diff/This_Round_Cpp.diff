+    uint64_t
+    CHAOSPropagation::mmuBeginMissTranslation(uint64_t seq, Addr va,
+                                              const char *mode, bool stage2,
+                                              uint16_t asid, uint16_t vmid,
+                                              unsigned regime, unsigned ss)
