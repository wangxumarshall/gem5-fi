+    uint64_t
+    CHAOSPropagation::mmuNotePtwRequest(uint64_t ptw_request_id,
+                                        uint64_t walk_id,
+                                        uint64_t translation_id,
+                                        uint64_t unique_id, uint64_t seq,
+                                        Addr va, Addr pte_addr,
+                                        unsigned level,
+                                        uint64_t pte_read_event)
+    {
