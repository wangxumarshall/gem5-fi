+        if (suppressed) {
+            kv.push_back({"entry_generation_after", std::to_string(gen)});
+            if (suppress_phase)
+                kv.push_back({"fault_reason", suppress_phase});
+        }
+        mmuSetParent(kv, parent);
+        const uint64_t eid = notePropEvt("tlbi_match", kv);
+        mmu_tlbi_last[tlbi_id] = eid;
+        return eid;
