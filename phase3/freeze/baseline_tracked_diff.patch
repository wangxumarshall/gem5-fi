+        if (cand.lookupLevel != enums::ArmLookupLevel::L2)
+            continue;
+        if (cand.N != te.N || cand.tg != te.tg)
+            continue;
+        if (cand.regime != te.regime || cand.ss != te.ss)
+            continue;
+        if (cand.vmid != te.vmid)
