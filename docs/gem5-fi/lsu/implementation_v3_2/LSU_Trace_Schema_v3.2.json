          ]
        },
        "request_id": {
          "type": [
            "integer",
            "null"
          ]
        },
        "response_id": {
          "type": [
            "integer",
            "null"
          ]
        },
        "fragment_id": {
          "type": [
            "integer",
            "null"
          ]
        },
        "va": {
          "type": [
            "string",
            "null"
