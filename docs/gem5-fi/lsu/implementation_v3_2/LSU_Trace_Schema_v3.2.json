{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gem5-fi.local/schemas/LSU_Trace_Schema_v3.2.json",
  "title": "LSU Trace v3.1 JSONL record",
  "description": "One JSON object per line. Event records carry instruction identity, fault identity, propagation identity, request identity and state; propagation edges are separate records; exactly one summary record closes a complete trace.",
  "type": "object",
  "required": [
    "record_type",
    "trace_version"
  ],
  "properties": {
    "record_type": {
      "enum": [
        "event",
        "propagation_edge",
        "summary"
      ]
    },
    "trace_version": {
      "const": "v3.1"
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/event"
    },
    {
      "$ref": "#/$defs/edge"
    },
    {
      "$ref": "#/$defs/summary"
    }
  ],
  "$defs": {
    "enums": {
      "run_status": [
        "COMPLETED",
        "NO_ELIGIBLE_EVENT",
        "TIMEOUT",
        "SIMULATOR_ERROR"
      ],
      "activation": [
        "NOT_TRIGGERED",
        "TRIGGERED",
        "UNKNOWN"
      ],
      "terminal": [
        "MASKED",
        "SQUASHED",
        "DETECTED_CONTAINED",
