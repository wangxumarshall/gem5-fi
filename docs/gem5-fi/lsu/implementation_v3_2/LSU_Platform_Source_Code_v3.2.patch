+import json
+import sys
+from pathlib import Path
+
+import pytest
+
+PLATFORM = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(PLATFORM))
+
+from trace_completeness import check_completeness  # noqa: E402
+from trace_schema import EDGE_FIELDS, EVENT_FIELDS, SUMMARY_FIELDS, schema_required  # noqa: E402
+from trace_summary import summarize  # noqa: E402
+from trace_validator import validate  # noqa: E402
+from trace_writer import TraceWriteError, TraceWriter  # noqa: E402
+
+
+def make_writer(tmp_path):
+    return TraceWriter(tmp_path / "t.jsonl", "S-R01", "R", "S", "F1", "A01")
+
+
+def test_writer_emits_every_v31_field(tmp_path):
+    w = make_writer(tmp_path)
+    eid = w.event("injection", unit="AGU", dyn_inst_seq=10,
+                  old_value="0x1000", new_value="0x1008",
+                  injection_status="INJECTED")
+    rec = json.loads((tmp_path / "t.jsonl").read_text().splitlines()[0])
+    assert set(rec) == set(EVENT_FIELDS)
+    assert rec["event_id"] == eid
+    assert rec["dyn_inst_seq"] == 10
+    assert rec["replay_generation"] is None
+
+
+def test_orphan_edge_rejected(tmp_path):
+    w = make_writer(tmp_path)
+    with pytest.raises(TraceWriteError, match="orphan"):
+        w.edge(1, 2)
+
+
+def test_complete_trace_validates_and_summarizes(tmp_path):
+    w = make_writer(tmp_path)
+    e1 = w.event("injection", unit="AGU", dyn_inst_seq=10,
+                 old_value="0x1000", new_value="0x1008",
+                 injection_status="INJECTED", activation_status="TRIGGERED",
+                 trace_completeness="COMPLETE")
+    e2 = w.event("memory_response", parent_event_id=e1, unit="L1D",
+                 dyn_inst_seq=10, request_id=7, va="0x1008", pa="0x1008",
+                 activation_status="TRIGGERED", trace_completeness="COMPLETE")
+    w.edge(e1, e2, value_hash="deadbeef", trace_completeness="COMPLETE")
+    w.close(run_status="COMPLETED", activation="TRIGGERED",
+            terminal="MASKED", completeness="COMPLETE")
+    assert validate(tmp_path / "t.jsonl") == []
+    report = check_completeness(tmp_path / "t.jsonl")
+    assert report["trace_completeness"] == "COMPLETE"
+    assert report["terminal_state"] == "MASKED"
+    summary = summarize(tmp_path / "t.jsonl")
+    assert summary["events"] == 2
+    assert summary["edges"] == 1
+    assert summary["event_types"]["injection"] == 1
+
+
+def test_incomplete_trace_never_masked(tmp_path):
+    w = make_writer(tmp_path)
+    w.event("injection", dyn_inst_seq=1, injection_status="INJECTED",
+            activation_status="TRIGGERED")
+    with pytest.raises(TraceWriteError, match="incomplete trace cannot be classified MASKED"):
+        w.close(run_status="COMPLETED", activation="TRIGGERED",
+                terminal="MASKED", completeness="INCOMPLETE")
+    # Re-create with an honest incomplete terminal; the checker must preserve INCOMPLETE.
+    w2 = make_writer(tmp_path)
+    w2.event("injection", dyn_inst_seq=1, injection_status="INJECTED",
+             activation_status="TRIGGERED")
+    w2.close(run_status="TIMEOUT", activation="TRIGGERED",
+             terminal="HANG", completeness="INCOMPLETE")
+    report = check_completeness(tmp_path / "t.jsonl")
+    assert report["trace_completeness"] == "INCOMPLETE"
+    assert report["terminal_state"] != "MASKED"
+
+
+def test_missing_field_and_bad_summary_rejected(tmp_path):
+    w = make_writer(tmp_path)
+    w.event("injection", dyn_inst_seq=1, injection_status="INJECTED")
+    w.close(run_status="COMPLETED", activation="NOT_TRIGGERED",
+            terminal="HANG", completeness="INCOMPLETE")
+    path = tmp_path / "t.jsonl"
+    lines = path.read_text().splitlines()
+    rec = json.loads(lines[0])
+    del rec["replay_generation"]
+    lines[0] = json.dumps(rec)
+    summary = json.loads(lines[-1])
+    summary["counts"]["events"] = 99
+    lines[-1] = json.dumps(summary)
+    path.write_text("\n".join(lines) + "\n")
+    errs = validate(path)
+    assert any("missing fields" in e for e in errs)
+    assert any("summary events=99" in e for e in errs)
+
+
+def test_schema_constants_match_json_schema():
+    assert schema_required("event") == EVENT_FIELDS
+    assert schema_required("edge") == EDGE_FIELDS
+    assert schema_required("summary") == SUMMARY_FIELDS
diff --git a/docs/gem5-fi/lsu/implementation_v3_2/platform/tools/prop_trace_to_v31.py b/docs/gem5-fi/lsu/implementation_v3_2/platform/tools/prop_trace_to_v31.py
new file mode 100644
index 00000000..124abc1b
--- /dev/null
+++ b/docs/gem5-fi/lsu/implementation_v3_2/platform/tools/prop_trace_to_v31.py
@@ -0,0 +1,208 @@
+#!/usr/bin/env python3
+"""Convert a CHAOSPropagation CSV trace into Trace v3.1 JSONL.
+
+The CSV is the gem5-side real trace (one row per propagation node). This
+adapter preserves its node identity, dyn_inst_seq, request id, address and
+detail fields, and emits the full v3.1 field set plus separate
+``propagation_edge`` records. Fields gem5 does not expose (replay generation,
+LQ/SQ entry generation, response id) are written as null, never guessed.
+"""
+from __future__ import annotations
+
+import argparse
+import csv
+import gzip
+import json
+import sys
+from pathlib import Path
+
+PLATFORM = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(PLATFORM))
+
+from trace_writer import TraceWriter  # noqa: E402
+
+KIND_MAP = {
+    "inj": "injection",
+    "addr_form": "address_formed",
+    "mem_req": "memory_request",
+    "resp": "memory_response",
+    "taint_reg": "register_writeback",
+    "consumer": "consumer_commit",
+    "errant_commit": "errant_commit",
+    "funnel": "funnel",
+}
+UNIT_MAP = {
+    "inj": ("AGU", "injection"),
+    "addr_form": ("AGU", "effective_address"),
+    "mem_req": ("LSQ", "request"),
+    "resp": ("L1D", "response"),
+    "taint_reg": ("RF", "writeback"),
+    "consumer": ("Commit", "consumer"),
+    "errant_commit": ("Commit", "errant_commit"),
+    "funnel": ("Funnel", "counts"),
+}
+
+
+def _detail(text: str) -> dict[str, str]:
+    out = {}
+    for item in (text or "").split(";"):
+        if "=" in item:
+            key, value = item.split("=", 1)
+            out[key.strip()] = value.strip()
+    return out
+
+
+def _hex(value: str | None) -> str | None:
+    if not value:
+        return None
+    value = value.lower()
+    return value if value.startswith("0x") else "0x" + value
+
+
+def _int(value: str | None) -> int | None:
+    if value is None or value == "":
+        return None
+    try:
+        return int(value, 0)
+    except ValueError:
+        return None
+
+
+def convert(csv_path: Path, out_path: Path, *, sample_run_id: str, run_id: str,
+            sub_task_id: str, fault_id: str, fault_model_id: str,
+            run_status: str, activation: str, terminal: str,
+            completeness: str, terminal_reason: str | None = None,
+            no_summary: bool = False,
+            allow_truncated_complete: bool = False) -> dict:
+    rows = []
+    truncated = False
+    try:
+        with gzip.open(csv_path, "rt", encoding="utf-8", errors="replace") as fh:
+            for line in fh:
+                if line.startswith("#"):
+                    continue
+                if not line.strip():
+                    continue
+                rows.append(next(csv.reader([line])))
+    except (EOFError, OSError):
+        truncated = True
+
+    if allow_truncated_complete and terminal != "CRASH":
+        raise SystemExit("REFUSE: a truncated stream may only be completed for CRASH")
+    declared = "INCOMPLETE" if truncated and not allow_truncated_complete else completeness
+    if not no_summary and declared == "INCOMPLETE" and terminal == "MASKED":
+        raise SystemExit("REFUSE: incomplete trace cannot be MASKED")
+
+    w = TraceWriter(out_path, sample_run_id, run_id, sub_task_id,
+                    fault_id, fault_model_id)
+    last_by_ptag: dict[int, int] = {}
+    injection_by_ptag: dict[int, int] = {}
+    next_injection = 0
+    counts = {"events": 0, "edges": 0, "injections": 0, "activations": 0}
+    for row in rows:
+        if len(row) < 10:
+            continue
+        node_id, tick, ptag, kind, dyn_seq, req_id, addr, phys, arch, detail = row[:10]
+        ptag_i = int(ptag or 0)
+        kind = kind.strip()
+        d = _detail(detail)
+        old_addr = _hex(d.get("old_addr"))
+        new_addr = _hex(d.get("new_addr")) or _hex(addr)
+        injection_status = "NOT_APPLICABLE"
+        if kind == "inj":
+            injection_status = ("NO_CHANGE" if d.get("value_changed") == "0"
+                                else "INJECTED")
+            next_injection += 1
+            injection_by_ptag[ptag_i] = next_injection
+        injection_event_id = injection_by_ptag.get(ptag_i, 1)
+        activation_status = "TRIGGERED" if ptag_i > 0 else "UNKNOWN"
+        commit_status = "COMMITTED" if kind in ("consumer", "errant_commit") else "UNKNOWN"
+        unit, sub_unit = UNIT_MAP.get(kind, ("Unknown", kind))
+        # CHAOSPropagation writes a virtual address for addr_form/mem_req and
+        # a physical packet address for resp. Keep them in separate fields.
+        if kind == "resp":
+            va, pa = None, _hex(addr)
+        elif kind in ("addr_form", "mem_req"):
+            va, pa = _hex(addr), None
+        else:
+            va, pa = None, None
+        eid = w.event(
+            KIND_MAP.get(kind, kind),
+            parent_event_id=last_by_ptag.get(ptag_i),
+            injection_event_id=injection_event_id,
+            dyn_inst_seq=_int(dyn_seq),
+            timestamp=int(tick or 0),
+            unit=unit, sub_unit=sub_unit,
+            request_id=_int(req_id),
+            va=va, pa=pa,
+            old_value=old_addr,
+            new_value=new_addr,
+            injection_status=injection_status,
+            activation_status=activation_status,
+            commit_status=commit_status,
+            squash_status="UNKNOWN",
+            trace_completeness="COMPLETE" if declared == "COMPLETE" else "INCOMPLETE",
+            detail=detail,
+            source_node_id=int(node_id or 0),
+            ptag=ptag_i,
+        )
+        prev = last_by_ptag.get(ptag_i)
+        if prev is not None:
+            w.edge(prev, eid, edge_kind=kind,
+                   trace_completeness=("COMPLETE" if declared == "COMPLETE"
+                                       else "INCOMPLETE"))
+        last_by_ptag[ptag_i] = eid
+
+    if not no_summary and terminal == "CRASH":
+        # The simulator aborted before its normal trailer. Record the abort
+        # itself as the terminal event so the trace ends at the observed
+        # terminal state instead of silently stopping mid-chain.
+        w.event("simulator_abort", unit="Simulator", sub_unit="abort",
+                terminal_state="CRASH", commit_status="UNKNOWN",
+                squash_status="UNKNOWN", trace_completeness=declared,
+                detail=("gzip truncation observed" if truncated else
+                        "simulator abort after last completed node"))
+    if no_summary:
+        w.abort()
+        return {"rows": len(rows), "truncated": truncated, "summary": None}
+    summary = w.close(run_status=run_status, activation=activation,
+                      terminal=terminal, completeness=declared,
+                      terminal_state_reason=terminal_reason)
+    return {"rows": len(rows), "truncated": truncated, "summary": summary}
+
+
+def main(argv=None) -> int:
+    ap = argparse.ArgumentParser(description=__doc__)
+    ap.add_argument("csv")
+    ap.add_argument("out")
+    ap.add_argument("--sample-run-id", required=True)
+    ap.add_argument("--run-id", required=True)
+    ap.add_argument("--sub-task-id", required=True)
+    ap.add_argument("--fault-id", required=True)
+    ap.add_argument("--fault-model-id", required=True)
+    ap.add_argument("--run-status", required=True)
+    ap.add_argument("--activation", required=True)
+    ap.add_argument("--terminal", required=True)
+    ap.add_argument("--completeness", required=True)
+    ap.add_argument("--terminal-reason", default=None)
+    ap.add_argument("--no-summary", action="store_true",
+                    help="write events/edges only when the trace is incomplete")
+    ap.add_argument("--allow-truncated-complete", action="store_true",
+                    help="accept a gzip-truncated stream when a terminal CRASH "
+                         "event is appended (abort is the terminal state)")
+    args = ap.parse_args(argv)
+    result = convert(
+        Path(args.csv), Path(args.out),
+        sample_run_id=args.sample_run_id, run_id=args.run_id,
+        sub_task_id=args.sub_task_id, fault_id=args.fault_id,
+        fault_model_id=args.fault_model_id, run_status=args.run_status,
+        activation=args.activation, terminal=args.terminal,
+        completeness=args.completeness, terminal_reason=args.terminal_reason,
+        no_summary=args.no_summary,
+        allow_truncated_complete=args.allow_truncated_complete)
+    print(json.dumps(result, ensure_ascii=False))
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/docs/gem5-fi/lsu/implementation_v3_2/platform/trace_completeness.py b/docs/gem5-fi/lsu/implementation_v3_2/platform/trace_completeness.py
new file mode 100644
index 00000000..87373f85
--- /dev/null
+++ b/docs/gem5-fi/lsu/implementation_v3_2/platform/trace_completeness.py
@@ -0,0 +1,80 @@
+"""Trace completeness checker.
+
+A trace is COMPLETE only when it validates, has exactly one summary, and the
+summary is internally consistent with the events (TRIGGERED requires an
+injection event).  An incomplete trace never reports a terminal MASKED state.
+"""
+from __future__ import annotations
+
+import json
+import sys
+from pathlib import Path
+
+from trace_validator import read_records, validate
+
+
+def check_completeness(path: Path) -> dict:
+    path = Path(path)
+    reasons: list[str] = []
+    errs = validate(path)
+    if errs:
+        reasons.append(f"validation failed: {len(errs)} error(s)")
+        reasons.extend(errs[:20])
+    records = [r for r in read_records(path) if "__parse_error__" not in r]
+    events = [r for r in records if r.get("record_type") == "event"]
+    edges = [r for r in records if r.get("record_type") == "propagation_edge"]
+    summaries = [r for r in records if r.get("record_type") == "summary"]
+
+    if len(summaries) != 1:
+        reasons.append(f"expected one summary, got {len(summaries)}")
+        summary = summaries[0] if summaries else {}
+    else:
+        summary = summaries[0]
+
+    injections = [e for e in events
+                  if e.get("injection_status") in ("INJECTED", "NO_CHANGE")
+                  or e.get("event_type") == "injection"]
+    activations = [e for e in events if e.get("activation_status") == "TRIGGERED"]
+    if summary.get("fault_activation_status") == "TRIGGERED" and not injections:
+        reasons.append("summary says TRIGGERED but no injection event exists")
+    if summary.get("fault_activation_status") == "TRIGGERED" and not activations:
+        reasons.append("summary says TRIGGERED but no activation event exists")
+
+    declared = summary.get("trace_completeness")
+    if declared == "INCOMPLETE":
+        reasons.append("summary declares INCOMPLETE")
+    terminal = summary.get("terminal_state")
+    if declared == "INCOMPLETE" and terminal == "MASKED":
+        reasons.append("incomplete trace declares MASKED (forbidden)")
+        terminal = None
+
+    trace_completeness = "COMPLETE" if not reasons and declared == "COMPLETE" else "INCOMPLETE"
+    if trace_completeness == "INCOMPLETE" and terminal == "MASKED":
+        reasons.append("downgraded: MASKED requires a complete trace")
+        terminal = None
+    return {
+        "trace": str(path),
+        "trace_completeness": trace_completeness,
+        "terminal_state": terminal,
+        "run_status": summary.get("run_status"),
+        "fault_activation_status": summary.get("fault_activation_status"),
+        "events": len(events),
+        "edges": len(edges),
+        "injections": len(injections),
+        "activations": len(activations),
+        "reasons": reasons,
+    }
+
+
+def main(argv: list[str] | None = None) -> int:
+    argv = list(sys.argv[1:] if argv is None else argv)
+    if len(argv) != 1:
+        print("usage: trace_completeness.py <trace.jsonl[.gz]>", file=sys.stderr)
+        return 2
+    report = check_completeness(Path(argv[0]))
+    print(json.dumps(report, ensure_ascii=False, indent=2))
+    return 0 if report["trace_completeness"] == "COMPLETE" else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/docs/gem5-fi/lsu/implementation_v3_2/platform/trace_schema.py b/docs/gem5-fi/lsu/implementation_v3_2/platform/trace_schema.py
new file mode 100644
index 00000000..f34d89d9
--- /dev/null
+++ b/docs/gem5-fi/lsu/implementation_v3_2/platform/trace_schema.py
@@ -0,0 +1,60 @@
+"""Shared constants for Trace v3.1 records.
+
+The JSON Schema is the published contract; these tuples are the validator's
+stdlib implementation of the same contract (jsonschema is not a dependency of
+this repository).
+"""
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+TRACE_VERSION = "v3.1"
+SCHEMA_PATH = Path(__file__).resolve().parents[1] / "LSU_Trace_Schema_v3.2.json"
+
+RUN_STATUS = ("COMPLETED", "NO_ELIGIBLE_EVENT", "TIMEOUT", "SIMULATOR_ERROR")
+ACTIVATION = ("NOT_TRIGGERED", "TRIGGERED", "UNKNOWN")
+TERMINAL = ("MASKED", "SQUASHED", "DETECTED_CONTAINED",
+            "ARCH_STATE_CORRUPTION", "SDC", "CRASH", "HANG")
+COMPLETENESS = ("COMPLETE", "INCOMPLETE")
+INJECTION_STATUS = ("INJECTED", "NO_CHANGE", "DECLINED", "NOT_APPLICABLE")
+COMMIT_STATUS = ("NOT_COMMITTED", "COMMITTED", "SQUASHED", "UNKNOWN")
+SQUASH_STATUS = ("NONE", "SQUASHED", "UNKNOWN")
+
+EVENT_FIELDS = (
+    "record_type", "trace_version", "sample_run_id", "run_id", "sub_task_id",
+    "fault_id", "fault_model_id", "injection_event_id", "event_id",
+    "parent_event_id", "event_type", "unit", "sub_unit", "timestamp",
+    "dyn_inst_seq", "execution_attempt_id", "replay_generation", "commit_seq",
+    "source_event_id", "destination_event_id", "propagation_edge_id",
+    "producer_inst_seq", "consumer_inst_seq", "request_id", "response_id",
+    "fragment_id", "va", "pa", "lq_entry_id", "sq_entry_id",
+    "entry_generation", "old_value", "new_value", "injection_status",
+    "activation_status", "commit_status", "squash_status", "terminal_state",
+    "trace_completeness",
+)
+
+EDGE_FIELDS = (
+    "record_type", "trace_version", "event_type", "sample_run_id", "fault_id",
+    "fault_model_id", "propagation_edge_id", "source_event_id",
+    "destination_event_id", "producer_inst_seq", "consumer_inst_seq",
+    "edge_kind", "value_hash", "trace_completeness",
+)
+
+SUMMARY_FIELDS = (
+    "record_type", "trace_version", "sample_run_id", "fault_id",
+    "fault_model_id", "run_status", "fault_activation_status",
+    "terminal_state", "trace_completeness", "counts",
+)
+
+IDENTITY_FIELDS = ("sample_run_id", "run_id", "sub_task_id", "fault_id",
+                   "fault_model_id", "injection_event_id")
+
+
+def load_schema() -> dict:
+    return json.loads(SCHEMA_PATH.read_text(encoding="utf-8"))
+
+
+def schema_required(kind: str) -> tuple[str, ...]:
+    defs = load_schema()["$defs"]
+    return tuple(defs[kind]["required"])
diff --git a/docs/gem5-fi/lsu/implementation_v3_2/platform/trace_summary.py b/docs/gem5-fi/lsu/implementation_v3_2/platform/trace_summary.py
new file mode 100644
index 00000000..53e37362
--- /dev/null
+++ b/docs/gem5-fi/lsu/implementation_v3_2/platform/trace_summary.py
@@ -0,0 +1,49 @@
+"""Summarize a Trace v3.1 JSONL file (counts + terminal dimensions)."""
+from __future__ import annotations
+
+import json
+import sys
+from collections import Counter
+from pathlib import Path
+
+from trace_completeness import check_completeness
+from trace_validator import read_records
+
+
+def summarize(path: Path) -> dict:
+    records = [r for r in read_records(path) if "__parse_error__" not in r]
+    events = [r for r in records if r.get("record_type") == "event"]
+    edges = [r for r in records if r.get("record_type") == "propagation_edge"]
+    summaries = [r for r in records if r.get("record_type") == "summary"]
+    summary = summaries[0] if len(summaries) == 1 else {}
+    completeness = check_completeness(path)
+    return {
+        "trace": str(path),
+        "events": len(events),
+        "edges": len(edges),
+        "event_types": dict(Counter(e.get("event_type") for e in events)),
+        "units": dict(Counter(e.get("unit") for e in events)),
+        "injection_status": dict(Counter(e.get("injection_status") for e in events)),
+        "commit_status": dict(Counter(e.get("commit_status") for e in events)),
+        "squash_status": dict(Counter(e.get("squash_status") for e in events)),
+        "summary": {
+            "run_status": summary.get("run_status"),
+            "fault_activation_status": summary.get("fault_activation_status"),
+            "terminal_state": summary.get("terminal_state"),
+            "trace_completeness": summary.get("trace_completeness"),
+        },
+        "completeness_check": completeness,
+    }
+
+
+def main(argv: list[str] | None = None) -> int:
+    argv = list(sys.argv[1:] if argv is None else argv)
+    if len(argv) != 1:
+        print("usage: trace_summary.py <trace.jsonl[.gz]>", file=sys.stderr)
+        return 2
+    print(json.dumps(summarize(Path(argv[0])), ensure_ascii=False, indent=2))
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/docs/gem5-fi/lsu/implementation_v3_2/platform/trace_validator.py b/docs/gem5-fi/lsu/implementation_v3_2/platform/trace_validator.py
new file mode 100644
index 00000000..89934675
--- /dev/null
+++ b/docs/gem5-fi/lsu/implementation_v3_2/platform/trace_validator.py
@@ -0,0 +1,178 @@
+"""Stdlib validator for Trace v3.1 JSONL files.
+
+Checks the same required fields and enums as
+``LSU_Trace_Schema_v3.2.json`` plus cross-record integrity (unique event/edge
+ids, edge endpoints exist, exactly one trailing summary, consistent identity).
+"""
+from __future__ import annotations
+
+import gzip
+import json
+import sys
+from pathlib import Path
+from typing import Any
+
+from trace_schema import (
+    ACTIVATION, COMMIT_STATUS, COMPLETENESS, EDGE_FIELDS, EVENT_FIELDS,
+    INJECTION_STATUS, RUN_STATUS, SQUASH_STATUS, SUMMARY_FIELDS, TERMINAL,
+    TRACE_VERSION,
+)
+
+
+def read_records(path: Path) -> list[dict[str, Any]]:
+    path = Path(path)
+    opener = gzip.open if path.suffix == ".gz" else open
+    records: list[dict[str, Any]] = []
+    with opener(path, "rt", encoding="utf-8") as fh:
+        for line_no, line in enumerate(fh, 1):
+            if not line.strip():
+                continue
+            try:
+                rec = json.loads(line)
+            except json.JSONDecodeError as exc:
+                records.append({"__parse_error__": f"line {line_no}: {exc}"})
+                continue
+            rec["__line__"] = line_no
+            records.append(rec)
+    return records
+
+
+def validate_records(records: list[dict[str, Any]]) -> list[str]:
+    errs: list[str] = []
+    events: dict[int, dict[str, Any]] = {}
+    edge_ids: set[int] = set()
+    summaries: list[dict[str, Any]] = []
+    sample_ids: set[str] = set()
+
+    for rec in records:
+        line = rec.get("__line__", "?")
+        if "__parse_error__" in rec:
+            errs.append(rec["__parse_error__"])
+            continue
+        if rec.get("trace_version") != TRACE_VERSION:
+            errs.append(f"line {line}: trace_version must be {TRACE_VERSION!r}")
+        kind = rec.get("record_type")
+        if kind == "event":
+            missing = [k for k in EVENT_FIELDS if k not in rec]
+            if missing:
+                errs.append(f"line {line}: event missing fields {missing}")
+            eid = rec.get("event_id")
+            if not isinstance(eid, int) or eid < 1:
+                errs.append(f"line {line}: event_id must be a positive integer")
+            elif eid in events:
+                errs.append(f"line {line}: duplicate event_id {eid}")
+            else:
+                events[eid] = rec
+            for field_name, allowed in (
+                ("injection_status", INJECTION_STATUS),
+                ("activation_status", ACTIVATION),
+                ("commit_status", COMMIT_STATUS),
+                ("squash_status", SQUASH_STATUS),
+                ("trace_completeness", COMPLETENESS),
+            ):
+                value = rec.get(field_name)
+                if value not in allowed:
+                    errs.append(f"line {line}: {field_name}={value!r} not in {allowed}")
+            terminal = rec.get("terminal_state")
+            if terminal is not None and terminal not in TERMINAL:
+                errs.append(f"line {line}: terminal_state={terminal!r} not in {TERMINAL}")
+            for key in ("sample_run_id", "run_id", "sub_task_id", "fault_id",
+                        "fault_model_id", "event_type"):
+                if not isinstance(rec.get(key), str) or not rec.get(key):
+                    errs.append(f"line {line}: {key} must be a non-empty string")
+            if isinstance(rec.get("sample_run_id"), str):
+                sample_ids.add(rec["sample_run_id"])
+        elif kind == "propagation_edge":
+            missing = [k for k in EDGE_FIELDS if k not in rec]
+            if missing:
+                errs.append(f"line {line}: edge missing fields {missing}")
+            peid = rec.get("propagation_edge_id")
+            if not isinstance(peid, int) or peid < 1:
+                errs.append(f"line {line}: propagation_edge_id must be a positive integer")
+            elif peid in edge_ids:
+                errs.append(f"line {line}: duplicate propagation_edge_id {peid}")
+            else:
+                edge_ids.add(peid)
+            if rec.get("event_type") != "propagation_edge":
+                errs.append(f"line {line}: edge event_type must be 'propagation_edge'")
+            if rec.get("trace_completeness") not in COMPLETENESS:
+                errs.append(f"line {line}: bad edge trace_completeness")
+            if isinstance(rec.get("sample_run_id"), str):
+                sample_ids.add(rec["sample_run_id"])
+        elif kind == "summary":
+            missing = [k for k in SUMMARY_FIELDS if k not in rec]
+            if missing:
+                errs.append(f"line {line}: summary missing fields {missing}")
+            for field_name, allowed in (
+                ("run_status", RUN_STATUS),
+                ("fault_activation_status", ACTIVATION),
+                ("terminal_state", TERMINAL),
+                ("trace_completeness", COMPLETENESS),
+            ):
+                value = rec.get(field_name)
+                if value not in allowed:
+                    errs.append(f"line {line}: {field_name}={value!r} not in {allowed}")
+            if rec.get("trace_completeness") == "INCOMPLETE" and rec.get("terminal_state") == "MASKED":
+                errs.append(f"line {line}: incomplete trace cannot be MASKED")
+            counts = rec.get("counts")
+            if not isinstance(counts, dict) or not all(
+                    k in counts for k in ("events", "edges", "injections", "activations")):
+                errs.append(f"line {line}: summary counts must contain events/edges/injections/activations")
+            summaries.append(rec)
+            if isinstance(rec.get("sample_run_id"), str):
+                sample_ids.add(rec["sample_run_id"])
+        else:
+            errs.append(f"line {line}: unknown record_type {kind!r}")
+
+    # Two-pass endpoint and parent checks.
+    for rec in events.values():
+        parent = rec.get("parent_event_id")
+        if parent is not None and parent not in events:
+            errs.append(f"event {rec.get('event_id')}: parent_event_id {parent} does not exist")
+    for rec in records:
+        if rec.get("record_type") != "propagation_edge":
+            continue
+        for key in ("source_event_id", "destination_event_id"):
+            target = rec.get(key)
+            if target not in events:
+                errs.append(
+                    f"edge {rec.get('propagation_edge_id')}: {key}={target} is not an event")
+    if len(summaries) != 1:
+        errs.append(f"expected exactly one summary record, got {len(summaries)}")
+    elif records and summaries[0].get("__line__") != records[-1].get("__line__"):
+        errs.append("summary record must be the last line")
+    if len(sample_ids) > 1:
+        errs.append(f"trace mixes sample_run_id values: {sorted(sample_ids)}")
+    if summaries:
+        summary = summaries[0]
+        counts = summary.get("counts") or {}
+        if counts.get("events") != len(events):
+            errs.append(
+                f"summary events={counts.get('events')} but trace has {len(events)}")
+        if counts.get("edges") != len(edge_ids):
+            errs.append(
+                f"summary edges={counts.get('edges')} but trace has {len(edge_ids)}")
+    return errs
+
+
+def validate(path: Path) -> list[str]:
+    return validate_records(read_records(path))
+
+
+def main(argv: list[str] | None = None) -> int:
+    argv = list(sys.argv[1:] if argv is None else argv)
+    if len(argv) != 1:
+        print("usage: trace_validator.py <trace.jsonl[.gz]>", file=sys.stderr)
+        return 2
+    errs = validate(Path(argv[0]))
+    if errs:
+        print("INVALID")
+        for err in errs:
+            print(f"  {err}")
+        return 1
+    print("VALID")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/docs/gem5-fi/lsu/implementation_v3_2/platform/trace_writer.py b/docs/gem5-fi/lsu/implementation_v3_2/platform/trace_writer.py
new file mode 100644
index 00000000..b72041c6
--- /dev/null
+++ b/docs/gem5-fi/lsu/implementation_v3_2/platform/trace_writer.py
@@ -0,0 +1,204 @@
+"""Trace v3.1 JSONL writer.
+
+Every event record contains the full field set from
+``LSU_Trace_Schema_v3.2.json``; fields the microarchitecture cannot supply are
+written as JSON null rather than omitted or guessed.  Propagation is always a
+separate ``propagation_edge`` record.  The writer refuses to close a trace that
+would report ``MASKED`` with ``INCOMPLETE`` completeness.
+"""
+from __future__ import annotations
+
+import gzip
+import json
+from dataclasses import dataclass, field
+from pathlib import Path
+from typing import Any, TextIO
+
+from trace_schema import (
+    ACTIVATION, COMMIT_STATUS, COMPLETENESS, EDGE_FIELDS, EVENT_FIELDS,
+    INJECTION_STATUS, RUN_STATUS, SQUASH_STATUS, TERMINAL, TRACE_VERSION,
+)
+
+
+class TraceWriteError(ValueError):
+    pass
+
+
+@dataclass
+class TraceWriter:
+    path: Path
+    sample_run_id: str
+    run_id: str
+    sub_task_id: str
+    fault_id: str
+    fault_model_id: str
+    _event_id: int = 0
+    _edge_id: int = 0
+    _nodes: dict[int, dict[str, Any]] = field(default_factory=dict)
+    _counts: dict[str, int] = field(default_factory=lambda: {
+        "events": 0, "edges": 0, "injections": 0, "activations": 0})
+    _fh: TextIO | None = field(default=None, init=False, repr=False)
+    _closed: bool = field(default=False, init=False, repr=False)
+
+    def __post_init__(self) -> None:
+        self.path = Path(self.path)
+        self.path.parent.mkdir(parents=True, exist_ok=True)
+        if self.path.suffix == ".gz":
+            self._fh = gzip.open(self.path, "wt", encoding="utf-8", compresslevel=1)
+        else:
+            self._fh = self.path.open("w", encoding="utf-8")
+        for key in ("sample_run_id", "run_id", "sub_task_id", "fault_id", "fault_model_id"):
+            if not getattr(self, key):
+                raise TraceWriteError(f"{key} must be non-empty")
+
+    # -- writing ---------------------------------------------------------
+    def event(self, event_type: str, *, parent_event_id: int | None = None,
+              injection_event_id: int = 1, **fields: Any) -> int:
+        if self._closed or self._fh is None:
+            raise TraceWriteError("writer is closed")
+        self._event_id += 1
+        eid = self._event_id
+        rec: dict[str, Any] = {name: None for name in EVENT_FIELDS}
+        rec.update({
+            "record_type": "event",
+            "trace_version": TRACE_VERSION,
+            "sample_run_id": self.sample_run_id,
+            "run_id": self.run_id,
+            "sub_task_id": self.sub_task_id,
+            "fault_id": self.fault_id,
+            "fault_model_id": self.fault_model_id,
+            "injection_event_id": injection_event_id,
+            "event_id": eid,
+            "parent_event_id": parent_event_id,
+            "event_type": event_type,
+            "timestamp": 0,
+            "injection_status": "NOT_APPLICABLE",
+            "activation_status": "UNKNOWN",
+            "commit_status": "UNKNOWN",
+            "squash_status": "UNKNOWN",
+            "trace_completeness": "INCOMPLETE",
+        })
+        rec.update(fields)
+        self._validate_event(rec)
+        self._write(rec)
+        self._nodes[eid] = rec
+        self._counts["events"] += 1
+        if rec.get("injection_status") == "INJECTED" or event_type == "injection":
+            if rec.get("injection_status") in ("INJECTED", "NO_CHANGE") or event_type == "injection":
+                self._counts["injections"] += 1
+        if rec.get("activation_status") == "TRIGGERED":
+            self._counts["activations"] += 1
+        return eid
+
+    def edge(self, source_event_id: int, destination_event_id: int, *,
+             producer_inst_seq: int | None = None,
+             consumer_inst_seq: int | None = None,
+             edge_kind: str = "data", value_hash: str | None = None,
+             trace_completeness: str = "INCOMPLETE") -> int:
+        if self._closed or self._fh is None:
+            raise TraceWriteError("writer is closed")
+        if source_event_id not in self._nodes or destination_event_id not in self._nodes:
+            raise TraceWriteError(
+                f"orphan propagation edge: {source_event_id} -> {destination_event_id}")
+        self._edge_id += 1
+        src = self._nodes[source_event_id]
+        dst = self._nodes[destination_event_id]
+        rec = {name: None for name in EDGE_FIELDS}
+        rec.update({
+            "record_type": "propagation_edge",
+            "trace_version": TRACE_VERSION,
+            "event_type": "propagation_edge",
+            "sample_run_id": self.sample_run_id,
+            "fault_id": self.fault_id,
+            "fault_model_id": self.fault_model_id,
+            "propagation_edge_id": self._edge_id,
+            "source_event_id": source_event_id,
+            "destination_event_id": destination_event_id,
+            "producer_inst_seq": (producer_inst_seq if producer_inst_seq is not None
+                                  else src.get("dyn_inst_seq")),
+            "consumer_inst_seq": (consumer_inst_seq if consumer_inst_seq is not None
+                                  else dst.get("dyn_inst_seq")),
+            "edge_kind": edge_kind,
+            "value_hash": value_hash,
+            "trace_completeness": trace_completeness,
+        })
+        if trace_completeness not in COMPLETENESS:
+            raise TraceWriteError(f"bad edge trace_completeness {trace_completeness!r}")
+        self._write(rec)
+        self._counts["edges"] += 1
+        return self._edge_id
+
+    def close(self, *, run_status: str, activation: str, terminal: str,
+              completeness: str, terminal_state_reason: str | None = None) -> dict:
+        if self._closed or self._fh is None:
+            raise TraceWriteError("writer is already closed")
+        if run_status not in RUN_STATUS:
+            raise TraceWriteError(f"bad run_status {run_status!r}")
+        if activation not in ACTIVATION:
+            raise TraceWriteError(f"bad activation {activation!r}")
+        if terminal not in TERMINAL:
+            raise TraceWriteError(f"bad terminal state {terminal!r}")
+        if completeness not in COMPLETENESS:
+            raise TraceWriteError(f"bad completeness {completeness!r}")
+        if completeness == "INCOMPLETE" and terminal == "MASKED":
+            raise TraceWriteError(
+                "incomplete trace cannot be classified MASKED (v3.2 honesty rule)")
+        summary = {
+            "record_type": "summary",
+            "trace_version": TRACE_VERSION,
+            "sample_run_id": self.sample_run_id,
+            "fault_id": self.fault_id,
+            "fault_model_id": self.fault_model_id,
+            "run_status": run_status,
+            "fault_activation_status": activation,
+            "terminal_state": terminal,
+            "trace_completeness": completeness,
+            "terminal_state_reason": terminal_state_reason,
+            "counts": dict(self._counts),
+        }
+        self._write(summary)
+        self._fh.close()
+        self._closed = True
+        return summary
+
+    def abort(self) -> None:
+        """Close without a summary. Used only when the trace is known to be
+        incomplete; the validator and completeness checker then report the
+        missing summary instead of a fabricated terminal verdict."""
+        if not self._closed and self._fh is not None:
+            self._fh.close()
+            self._closed = True
+
+    def __enter__(self) -> "TraceWriter":
+        return self
+
+    def __exit__(self, exc_type, exc, tb) -> None:
+        if not self._closed and self._fh is not None:
+            self._fh.close()
+            self._closed = True
+
+    # -- helpers ---------------------------------------------------------
+    def _write(self, rec: dict[str, Any]) -> None:
+        assert self._fh is not None
+        self._fh.write(json.dumps(rec, ensure_ascii=False, separators=(",", ":")) + "\n")
+        self._fh.flush()
+
+    def _validate_event(self, rec: dict[str, Any]) -> None:
+        missing = [k for k in EVENT_FIELDS if k not in rec]
+        if missing:
+            raise TraceWriteError(f"event missing fields: {missing}")
+        if rec["record_type"] != "event":
+            raise TraceWriteError("record_type must be event")
+        if rec["trace_version"] != TRACE_VERSION:
+            raise TraceWriteError("trace_version must be v3.1")
+        for field_name, allowed in (
+            ("injection_status", INJECTION_STATUS),
+            ("activation_status", ACTIVATION),
+            ("commit_status", COMMIT_STATUS),
+            ("squash_status", SQUASH_STATUS),
+            ("trace_completeness", COMPLETENESS),
+        ):
+            if rec[field_name] not in allowed:
+                raise TraceWriteError(f"{field_name}={rec[field_name]!r} not in {allowed}")
+        if rec["terminal_state"] is not None and rec["terminal_state"] not in TERMINAL:
+            raise TraceWriteError(f"terminal_state={rec['terminal_state']!r} not in {TERMINAL}")
