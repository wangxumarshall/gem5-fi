+++ b/docs/gem5-fi/lsu/implementation_v3_2/platform/oracle.py
@@ -0,0 +1,60 @@
+"""Oracle interface: compare the frozen expected checksum with real gem5 stdout."""
+from __future__ import annotations
+
+import argparse
+import json
+import re
+import sys
+from pathlib import Path
+
+CHECKSUM_RE = re.compile(r"checksum=0x([0-9a-fA-F]+)")
+BARE_HEX_RE = re.compile(r"^\s*([0-9a-fA-F]{16})\s*$", re.MULTILINE)
+
+
+def normalize(value: str) -> str:
+    text = str(value).strip().lower()
+    if "checksum=0x" in text:
+        text = text.split("checksum=0x")[-1]
+    return text.strip().removeprefix("0x")
+
+
+def extract_checksum(text: str) -> str | None:
+    matches = CHECKSUM_RE.findall(text)
+    if matches:
+        return matches[-1].lower()
+    # W1/W4 print a bare 16-hex checksum line (no checksum=0x prefix).
+    bare = BARE_HEX_RE.findall(text)
+    return bare[-1].lower() if bare else None
+
+
+def check_oracle(expected: str, stdout_text: str) -> dict:
+    want = normalize(expected)
+    got = extract_checksum(stdout_text)
+    if got is None:
+        return {"status": "MISSING", "expected": want, "got": None,
+                "reason": "no checksum=0x... line in stdout"}
+    status = "PASS" if got == want else "FAIL"
+    return {"status": status, "expected": want, "got": got}
+
+
+def check_oracle_file(expected: str, stdout_path: Path) -> dict:
+    return check_oracle(expected, Path(stdout_path).read_text(encoding="utf-8", errors="replace"))
+
+
+def main(argv: list[str] | None = None) -> int:
+    ap = argparse.ArgumentParser(description=__doc__)
+    ap.add_argument("expected", help="frozen golden checksum (with or without 0x)")
+    ap.add_argument("stdout", type=Path)
+    ap.add_argument("--json", action="store_true")
+    args = ap.parse_args(argv)
+    result = check_oracle_file(args.expected, args.stdout)
+    if args.json:
+        print(json.dumps(result, ensure_ascii=False))
+    else:
+        print(f"expected={result['expected']} got={result['got']}")
+        print(f"ORACLE_{result['status']}")
+    return 0 if result["status"] == "PASS" else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/docs/gem5-fi/lsu/implementation_v3_2/platform/run_gate1.sh b/docs/gem5-fi/lsu/implementation_v3_2/platform/run_gate1.sh
new file mode 100755
index 00000000..b31c682f
--- /dev/null
+++ b/docs/gem5-fi/lsu/implementation_v3_2/platform/run_gate1.sh
@@ -0,0 +1,47 @@
+#!/usr/bin/env bash
+# Gate-1 reproducible verification. Run from anywhere; all paths are derived
+# from this script's location. Exit 0 = all platform unit tests passed.
+set -uo pipefail
+
+PLATFORM="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+IMPL="$(dirname "$PLATFORM")"
+LSUS="$(dirname "$IMPL")"
+WORKBOOK="$IMPL/gem5-fi-LSU-Final-Paper-Experiment-Plan-v3.2.xlsx"
+if [ ! -f "$WORKBOOK" ]; then
+  WORKBOOK="$LSUS/final_paper_audit_v3_1/gem5-fi-LSU-Final-Paper-Experiment-Plan-v3.1.xlsx"
+fi
+LOGS="$IMPL/logs"
+mkdir -p "$LOGS"
+
+cd "$PLATFORM" || exit 2
+echo "== pytest =="
+python3 -m pytest tests -v 2>&1 | tee "$LOGS/gate1_tests.log"
+test_rc=${PIPESTATUS[0]}
+
+echo "== config parser (strict on the v3.2 workbook) =="
+python3 config_parser.py "$WORKBOOK" "$LOGS/config_v32.json" \
+    2>&1 | tee "$LOGS/gate1_config_validation.log"
+cfg_rc=${PIPESTATUS[0]}
+
+# Preserve the frozen v3.1 deficit evidence separately; this is diagnostic
+# only and never feeds the Gate-1 pass/fail decision.
+V31="$LSUS/final_paper_audit_v3_1/gem5-fi-LSU-Final-Paper-Experiment-Plan-v3.1.xlsx"
+if [ -f "$V31" ]; then
+  python3 config_parser.py "$V31" "$LOGS/config_v31.json" --allow-incomplete \
+      > "$LOGS/gate1_config_v31_deficits.log" 2>&1 || true
+fi
+
+echo "== trace sample validator =="
+python3 trace_validator.py "$IMPL/LSU_Trace_Sample_v3.2.jsonl" | tee "$LOGS/gate1_trace_validator.log"
+val_rc=${PIPESTATUS[0]}
+
+echo "== trace sample completeness =="
+python3 trace_completeness.py "$IMPL/LSU_Trace_Sample_v3.2.jsonl" > "$LOGS/gate1_trace_completeness.json"
+comp_rc=$?
+
+echo "== summary =="
+echo "pytest_rc=$test_rc config_rc=$cfg_rc validator_rc=$val_rc completeness_rc=$comp_rc"
+if [ "$test_rc" -ne 0 ] || [ "$cfg_rc" -ne 0 ] || [ "$val_rc" -ne 0 ] || [ "$comp_rc" -ne 0 ]; then
+  exit 1
+fi
+exit 0
diff --git a/docs/gem5-fi/lsu/implementation_v3_2/platform/run_pilot.py b/docs/gem5-fi/lsu/implementation_v3_2/platform/run_pilot.py
