+    CHAOSPropagation::noteA03FaultVA(uint64_t dyn_inst_seq, uint64_t fault_va)
+    {
+        if (!write_log)
+            return;
+        auto it = a03_last_row.find(dyn_inst_seq);
+        if (it == a03_last_row.end())
+            return;
+        const A03Row &row = it->second;
+        std::ostringstream d;
+        d << "record=crash_addr_link;family=a03"
