flowchart LR
    BPU["BPU 分支预测器（BTB·RAS·方向/目标）<br/>⚡CHAOSBPU(2模式)"]:::cap
    FTQ["FTQ 取指目标队列<br/>无注入挂载"]:::plain
    ICACHE["ICache 取指<br/>无注入挂载"]:::plain
    DECODER["Decoder（编码→StaticInst）<br/>⚡CHAOSDecode(26模式)"]:::cap
    RAT["RAT 重命名映射表<br/>⚡CHAOSRenameMap(14模式)"]:::cap
    FREELIST["FreeList 空闲物理寄存器表<br/>⚡CHAOSFreeList(7模式)"]:::cap
    IQ["IQ 发射队列（源标签 CAM·就绪位·唤醒）<br/>⚡CHAOSIQ(12模式)"]:::cap
    LSQ["LSQ（LQ/SQ·store→load 前送·独占监视）<br/>⚡CHAOSLSQFwd(6模式) ⚡CHAOSExMon(2模式)"]:::cap
    FU["FU 池（IntALU·IntDiv·IntMult·SimdCrcOp）<br/>⚡CHAOSExec(整数结果 XOR 位翻转（exec_fault_mask 参数化）) ⚡CHAOSFPU(6模式)"]:::cap
    TLBPATH["地址通路（翻译前 vaddr·TLB）<br/>⚡CHAOSAddrPath(2模式)"]:::cap
    L1D["L1D 返回通路（ECC 后包数据）<br/>⚡CHAOSL1DForward(L1D 返回包数据位翻转（fault_mask 参数化）) ⚡CHAOSCache(cache 行数据注入（arm_chaos_cache 配置族）)"]:::cap
    DRAM["内存子系统（DRAM 保护模型）<br/>⚡CHAOSMem(参数化注入)"]:::cap
    PRF["PRF 物理寄存器堆<br/>⚡CHAOSPhysReg(3模式)"]:::cap
    ROB["ROB 重排序缓冲（pc·dest·done·exc·指针）<br/>⚡CHAOSROB(28模式) ⚡CHAOSRAS(提交期 head fault 清除（异常抑制）)"]:::cap
    ARCHRF["架构寄存器堆（提交态）<br/>⚡CHAOSReg(4模式)"]:::cap
    OBS["观测器（占基采样·commit 轨迹，只读）<br/>👁CHAOSProbe(观测) 👁CHAOSCommitTrace(观测)"]:::cap
    BPU --> FTQ
    DECODER --> RAT
    FREELIST --> IQ
    FTQ --> ICACHE
    FU --> PRF
    ICACHE --> DECODER
    IQ --> FU
    IQ --> LSQ
    L1D --> PRF
    LSQ --> TLBPATH
    PRF --> ROB
    RAT --> FREELIST
    ROB --> ARCHRF
    TLBPATH --> L1D
    FU -.-> ICACHE
    L1D --> DRAM
    classDef cap fill:#fdd,stroke:#900,stroke-width:2px
    classDef plain fill:#eee,stroke:#999
