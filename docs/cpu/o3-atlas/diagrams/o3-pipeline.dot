digraph o3_atlas {
    rankdir=LR; node [shape=box];
    BPU [label="BPU 分支预测器（BTB·RAS·方向/目标）\n⚡CHAOSBPU(2模式)", style=filled, fillcolor="#fdd", color="#900"];
    FTQ [label="FTQ 取指目标队列\n无注入挂载", style=filled, fillcolor="#eee"];
    ICACHE [label="ICache 取指\n无注入挂载", style=filled, fillcolor="#eee"];
    DECODER [label="Decoder（编码→StaticInst）\n⚡CHAOSDecode(26模式)", style=filled, fillcolor="#fdd", color="#900"];
    RAT [label="RAT 重命名映射表\n⚡CHAOSRenameMap(14模式)", style=filled, fillcolor="#fdd", color="#900"];
    FREELIST [label="FreeList 空闲物理寄存器表\n⚡CHAOSFreeList(7模式)", style=filled, fillcolor="#fdd", color="#900"];
    IQ [label="IQ 发射队列（源标签 CAM·就绪位·唤醒）\n⚡CHAOSIQ(12模式)", style=filled, fillcolor="#fdd", color="#900"];
    LSQ [label="LSQ（LQ/SQ·store→load 前送·独占监视）\n⚡CHAOSLSQFwd(6模式) | ⚡CHAOSExMon(2模式)", style=filled, fillcolor="#fdd", color="#900"];
    FU [label="FU 池（IntALU·IntDiv·IntMult·SimdCrcOp）\n⚡CHAOSExec(整数结果 XOR 位翻转（exec_fault_mask 参数化）) | ⚡CHAOSFPU(6模式)", style=filled, fillcolor="#fdd", color="#900"];
    TLBPATH [label="地址通路（翻译前 vaddr·TLB）\n⚡CHAOSAddrPath(2模式)", style=filled, fillcolor="#fdd", color="#900"];
    L1D [label="L1D 返回通路（ECC 后包数据）\n⚡CHAOSL1DForward(L1D 返回包数据位翻转（fault_mask 参数化）) | ⚡CHAOSCache(cache 行数据注入（arm_chaos_cache 配置族）)", style=filled, fillcolor="#fdd", color="#900"];
    DRAM [label="内存子系统（DRAM 保护模型）\n⚡CHAOSMem(参数化注入)", style=filled, fillcolor="#fdd", color="#900"];
    PRF [label="PRF 物理寄存器堆\n⚡CHAOSPhysReg(3模式)", style=filled, fillcolor="#fdd", color="#900"];
    ROB [label="ROB 重排序缓冲（pc·dest·done·exc·指针）\n⚡CHAOSROB(28模式) | ⚡CHAOSRAS(提交期 head fault 清除（异常抑制）)", style=filled, fillcolor="#fdd", color="#900"];
    ARCHRF [label="架构寄存器堆（提交态）\n⚡CHAOSReg(4模式)", style=filled, fillcolor="#fdd", color="#900"];
    OBS [label="观测器（占基采样·commit 轨迹，只读）\n👁CHAOSProbe(观测) | 👁CHAOSCommitTrace(观测)", style=filled, fillcolor="#fdd", color="#900"];
    BPU -> FTQ;
    DECODER -> RAT;
    FREELIST -> IQ;
    FTQ -> ICACHE;
    FU -> PRF;
    ICACHE -> DECODER;
    IQ -> FU;
    IQ -> LSQ;
    L1D -> PRF;
    LSQ -> TLBPATH;
    PRF -> ROB;
    RAT -> FREELIST;
    ROB -> ARCHRF;
    TLBPATH -> L1D;
    FU -> ICACHE [style=dashed, label=误预测重定向];
    L1D -> DRAM;
}
