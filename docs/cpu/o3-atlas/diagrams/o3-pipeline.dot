digraph o3_atlas {
    rankdir=LR; node [shape=box];
    BPU [label="BPU"];
    FTQ [label="FTQ"];
    FETCH [label="FETCH"];
    DECODE [label="DECODE"];
    RENAME [label="RENAME"];
    DISPATCH [label="DISPATCH"];
    ISSUE [label="ISSUE"];
    EXECUTE [label="EXECUTE"];
    MEMORY [label="MEMORY"];
    WRITEBACK [label="WRITEBACK"];
    COMMIT [label="COMMIT"];
    REDIRECT [label="REDIRECT"];
    BPU -> FTQ;
    FTQ -> FETCH;
    FETCH -> DECODE;
    DECODE -> RENAME;
    RENAME -> DISPATCH;
    DISPATCH -> ISSUE;
    ISSUE -> EXECUTE;
    EXECUTE -> MEMORY;
    MEMORY -> WRITEBACK;
    WRITEBACK -> COMMIT;
    COMMIT -> REDIRECT [style=dashed, label="误预测恢复"];
    REDIRECT -> FETCH [style=dashed];
    CHAOSAddrPath [label="CHAOSAddrPath", shape=hexagon, style=filled, fillcolor="#fdd", color="#900"];
    CHAOSAddrPath -> MEMORY [style=dashed, label=命中];
    CHAOSBPU [label="CHAOSBPU", shape=hexagon, style=filled, fillcolor="#fdd", color="#900"];
    CHAOSBPU -> BPU [style=dashed, label=命中];
    CHAOSCache [label="CHAOSCache", shape=hexagon, style=filled, fillcolor="#fdd", color="#900"];
    CHAOSCache -> MEMORY [style=dashed, label=命中];
    CHAOSCommitTrace [label="CHAOSCommitTrace", shape=hexagon, style=filled, fillcolor="#fdd", color="#900"];
    CHAOSCommitTrace -> COMMIT [style=dashed, label=命中];
    CHAOSDecode [label="CHAOSDecode", shape=hexagon, style=filled, fillcolor="#fdd", color="#900"];
    CHAOSDecode -> DECODE [style=dashed, label=命中];
    CHAOSExMon [label="CHAOSExMon", shape=hexagon, style=filled, fillcolor="#fdd", color="#900"];
    CHAOSExMon -> MEMORY [style=dashed, label=命中];
    CHAOSExec [label="CHAOSExec", shape=hexagon, style=filled, fillcolor="#fdd", color="#900"];
    CHAOSExec -> EXECUTE [style=dashed, label=命中];
    CHAOSFPU [label="CHAOSFPU", shape=hexagon, style=filled, fillcolor="#fdd", color="#900"];
    CHAOSFPU -> EXECUTE [style=dashed, label=命中];
    CHAOSFreeList [label="CHAOSFreeList", shape=hexagon, style=filled, fillcolor="#fdd", color="#900"];
    CHAOSFreeList -> RENAME [style=dashed, label=命中];
    CHAOSIQ [label="CHAOSIQ", shape=hexagon, style=filled, fillcolor="#fdd", color="#900"];
    CHAOSIQ -> ISSUE [style=dashed, label=命中];
    CHAOSL1DForward [label="CHAOSL1DForward", shape=hexagon, style=filled, fillcolor="#fdd", color="#900"];
    CHAOSL1DForward -> MEMORY [style=dashed, label=命中];
    CHAOSLSQFwd [label="CHAOSLSQFwd", shape=hexagon, style=filled, fillcolor="#fdd", color="#900"];
    CHAOSLSQFwd -> MEMORY [style=dashed, label=命中];
    CHAOSMem [label="CHAOSMem", shape=hexagon, style=filled, fillcolor="#fdd", color="#900"];
    CHAOSMem -> MEMORY [style=dashed, label=命中];
    CHAOSPhysReg [label="CHAOSPhysReg", shape=hexagon, style=filled, fillcolor="#fdd", color="#900"];
    CHAOSPhysReg -> EXECUTE [style=dashed, label=命中];
    CHAOSProbe [label="CHAOSProbe", shape=hexagon, style=filled, fillcolor="#fdd", color="#900"];
    CHAOSProbe -> COMMIT [style=dashed, label=命中];
    CHAOSRAS [label="CHAOSRAS", shape=hexagon, style=filled, fillcolor="#fdd", color="#900"];
    CHAOSRAS -> COMMIT [style=dashed, label=命中];
    CHAOSROB [label="CHAOSROB", shape=hexagon, style=filled, fillcolor="#fdd", color="#900"];
    CHAOSROB -> COMMIT [style=dashed, label=命中];
    CHAOSReg [label="CHAOSReg", shape=hexagon, style=filled, fillcolor="#fdd", color="#900"];
    CHAOSReg -> COMMIT [style=dashed, label=命中];
    CHAOSRenameMap [label="CHAOSRenameMap", shape=hexagon, style=filled, fillcolor="#fdd", color="#900"];
    CHAOSRenameMap -> RENAME [style=dashed, label=命中];
}
