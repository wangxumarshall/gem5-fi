digraph o3_atlas {
    rankdir=TB;
    subgraph cluster_pipeline {
        label="⟦CPU 微架构流水线⟧ 指令流=implemented 指令链路并集";
        node [shape=box];
        BPU [label="BPU\nBTB·RAS·方向/目标预测"];
        FTQ [label="FTQ\n取指目标队列"];
        FETCH [label="FETCH\nICache 取指"];
        DECODE [label="DECODE\nDecoder→StaticInst"];
        RENAME [label="RENAME\nRAT·FreeList→物理标签"];
        DISPATCH [label="DISPATCH\nIQ/LSQ 入队"];
        ISSUE [label="ISSUE\nIQ 唤醒·选择"];
        EXECUTE [label="EXECUTE\nFU 池（IntALU·IntDiv·IntMult·SimdCrcOp）"];
        MEMORY [label="MEMORY\nLSQ·L1D·TLB"];
        WRITEBACK [label="WRITEBACK\nPRF 写回"];
        COMMIT [label="COMMIT\nROB→架构RF"];
        REDIRECT [label="REDIRECT\n误预测重定向"];
        BPU -> FTQ;
        COMMIT -> REDIRECT [style=dashed, label="误预测"];
        DECODE -> RENAME;
        DISPATCH -> ISSUE;
        EXECUTE -> MEMORY;
        EXECUTE -> WRITEBACK;
        FETCH -> DECODE;
        FTQ -> FETCH;
        ISSUE -> EXECUTE;
        MEMORY -> WRITEBACK;
        RENAME -> DISPATCH;
        WRITEBACK -> COMMIT;
        REDIRECT -> FETCH [style=dashed];
    }
    subgraph cluster_caps {
        label="⟦故障注入能力层⟧ ⚡注入器(模式数)·👁观测器（实时解析自 ooo_proxy.py）";
        node [shape=hexagon, style=filled, fillcolor="#fdd", color="#900"];
        CHAOSBPU [label="⚡CHAOSBPU(2模式)\ndir_flip, target_flip"];
        CHAOSDecode [label="⚡CHAOSDecode(26模式)\ndest_reg_sub, opcode_bitflip, opcode_bitflip2…"];
        CHAOSFreeList [label="⚡CHAOSFreeList(7模式)\nmark_free, pop_wrong, mark_free_event…"];
        CHAOSRenameMap [label="⚡CHAOSRenameMap(14模式)\nmap_bitflip, map_bitflip2, map_bitflip2_adj…"];
        CHAOSIQ [label="⚡CHAOSIQ(12模式)\nwake_omit, src_ready_bitflip, wake_phase…"];
        CHAOSExec [label="⚡CHAOSExec\n整数结果 XOR 位翻转（exec_fault_mask 参数化）"];
        CHAOSFPU [label="⚡CHAOSFPU(6模式)\n, , , , , …"];
        CHAOSPhysReg [label="⚡CHAOSPhysReg(3模式)\nphys, arch_frontend, arch_commit"];
        CHAOSAddrPath [label="⚡CHAOSAddrPath(2模式)\nbyte7_zero, low_bit_flip"];
        CHAOSCache [label="⚡CHAOSCache\ncache 行数据注入（arm_chaos_cache 配置族）"];
        CHAOSExMon [label="⚡CHAOSExMon(2模式)\nstxr_force_success, stxr_force_fail"];
        CHAOSL1DForward [label="⚡CHAOSL1DForward\nL1D 返回包数据位翻转（fault_mask 参数化）"];
        CHAOSLSQFwd [label="⚡CHAOSLSQFwd(6模式)\nbyte_flip, byte_lane_skew, stale_line_replay…"];
        CHAOSMem [label="⚡CHAOSMem\n参数化注入"];
        CHAOSCommitTrace [label="👁CHAOSCommitTrace(观测)"];
        CHAOSProbe [label="👁CHAOSProbe(观测)"];
        CHAOSRAS [label="⚡CHAOSRAS\n提交期 head fault 清除（异常抑制）"];
        CHAOSROB [label="⚡CHAOSROB(28模式)\nentry_bitflip, exc_suppress, pc_bitflip…"];
        CHAOSReg [label="⚡CHAOSReg(4模式)\nbit_flip, stuck_at_zero, stuck_at_one…"];
    }
    MEMORY -> CHAOSAddrPath [style=dashed];
    BPU -> CHAOSBPU [style=dashed];
    MEMORY -> CHAOSCache [style=dashed];
    COMMIT -> CHAOSCommitTrace [style=dashed];
    DECODE -> CHAOSDecode [style=dashed];
    MEMORY -> CHAOSExMon [style=dashed];
    EXECUTE -> CHAOSExec [style=dashed];
    EXECUTE -> CHAOSFPU [style=dashed];
    RENAME -> CHAOSFreeList [style=dashed];
    ISSUE -> CHAOSIQ [style=dashed];
    MEMORY -> CHAOSL1DForward [style=dashed];
    MEMORY -> CHAOSLSQFwd [style=dashed];
    MEMORY -> CHAOSMem [style=dashed];
    EXECUTE -> CHAOSPhysReg [style=dashed];
    COMMIT -> CHAOSProbe [style=dashed];
    COMMIT -> CHAOSRAS [style=dashed];
    COMMIT -> CHAOSROB [style=dashed];
    COMMIT -> CHAOSReg [style=dashed];
    RENAME -> CHAOSRenameMap [style=dashed];
}
