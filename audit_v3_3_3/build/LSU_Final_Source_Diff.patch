+            if exp != golden else "none")
+        if exp != golden:
+            warnings.append(
+                f"{wid}: v3.2.7 ExpectedGolden={exp!r} is stale; "
+                f"using verified Oracle={got!r} (ledger L-D09)")
+    return rows, warnings
