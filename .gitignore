# The official gem5 upstream source tree is vendored under CHAOS/gem5/ as
# ordinary tracked files. These must NOT be committed:
#   - the upstream .git database (large, nested)
#   - build/m5out artifacts (huge; also covered by nested upstream .gitignore)
CHAOS/gem5/.git/
build/
m5out/

# Full-system-sim dependencies (kernels, disk images, dtb, boot ROM) —
# ~2.5GB (ubuntu.img alone is ~2.2GB). Must NOT be committed. These are
# the FS-mode deps used by Phase 3 (TLB/system-register FI); users fetch
# them separately.
gem5-fs/

# logs
*.log

.DS_Store
.claude/
