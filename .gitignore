# The official gem5 upstream source tree is vendored under CHAOS/gem5/ as
# ordinary tracked files. These must NOT be committed:
#   - the upstream .git database (large, nested)
#   - build/m5out artifacts (huge; also covered by nested upstream .gitignore)
CHAOS/gem5/.git/
build/
m5out/

# logs
*.log

.DS_Store
.claude/

# gem5 full-system support files (gem5-fs/) are large binaries (~2.5 GB) that
# must NOT be committed — only the README is tracked.
gem5-fs/*
!gem5-fs/readme.md
